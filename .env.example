# --- Google Sheets (database) -------------------------------------------------
# Leave GOOGLE_SHEET_ID empty in development to use a local JSON file (.data/store.json).
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the service-account JSON. Keep the \n escapes, wrap in quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Auth ---------------------------------------------------------------------
# Long random string used to sign login cookies:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Password for /admin
ADMIN_PASSWORD=
